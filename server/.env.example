
APP_NAME=ImageShrink-AI
APP_ENV=development
DEBUG=true
PORT=8000


MONGO_URI=mongodb://localhost:27017/imageshrink_ai
MONGO_DB_NAME=imageshrink_ai

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Only used by the browser-based device-login flow (/activate). The VS Code extension is
# standalone and never calls this API, so nothing uses it today.
WEB_APP_URL=http://localhost:5173

MAX_API_KEYS_PER_USER=10

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=zai-glm-4.7

MODEL_REQUESTS_PER_MINUTE=5
MODEL_RATE_WINDOW_SECONDS=60
MODEL_MAX_ATTEMPTS=4
MODEL_MAX_QUEUE_WAIT_SECONDS=45
MODEL_COOLDOWN_SECONDS=30
MODEL_UNAVAILABLE_COOLDOWN_SECONDS=300
MODEL_MAX_CANDIDATES=5
MODEL_FALLBACK_CHAIN=
MODEL_CATALOG_CACHE_SECONDS=300
MODEL_HEALTH_CACHE_SECONDS=60
MODEL_PROBE_TIMEOUT_SECONDS=15

MAX_UPLOAD_SIZE_MB=10

SHARED_DIR=

TRIVY_ENABLED=true
TRIVY_BINARY=trivy
TRIVY_TIMEOUT_SECONDS=120
TRIVY_TOTAL_TIMEOUT_SECONDS=180
TRIVY_MAX_CONCURRENT_SCANS=1
TRIVY_SEVERITIES=CRITICAL,HIGH,MEDIUM,LOW
TRIVY_CACHE_TTL_MINUTES=60
TRIVY_MAX_IMAGES=4
TRIVY_MAX_FINDINGS=100
TRIVY_SKIP_DB_UPDATE=true
