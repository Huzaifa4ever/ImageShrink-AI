# Local development settings. Copy to .env and fill in the three required values.
#
# This file NEVER reaches Azure. It is in .gitignore (so it stays out of git) and in
# .dockerignore (so it stays out of the image). In production the same names are read from
# real environment variables instead — three of them from Key Vault, the rest typed into the
# container app. So nothing here can "leak into" or break the deployment.
#
# Every setting below has a default in app/core/config.py. Anything you do not set uses that
# default. That is why this file is short: you only override what you actually want to change.
# The full list of tuning knobs is in that file, documented next to its default.

# ─── Required: the app will not work without these ─────────────────────────────

# Local container, or a hosted cluster. A password containing @ / : % ? or # must be
# percent-encoded, or the URI will not parse.
#
# If a hosted cluster reports "MongoDB unavailable" while it is clearly healthy, the
# mongodb+srv:// form is the likely cause — it needs a DNS SRV lookup that some resolvers
# (notably systemd-resolved on 127.0.0.53) refuse. Check with:
#     dig +short SRV _mongodb._tcp.<cluster>.mongodb.net
#     dig +short @1.1.1.1 SRV _mongodb._tcp.<cluster>.mongodb.net
# If the first is empty and the second works, use the direct form. Atlas lists it under
# Connect -> Drivers -> "older drivers". It names each host, so no SRV lookup happens.
MONGO_URI=mongodb://localhost:27017/imageshrink_ai

# Signs user login tokens. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# From console.groq.com/keys
GROQ_API_KEY=

# ─── Worth setting locally ─────────────────────────────────────────────────────

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Which web addresses the browser is allowed to call this API from. Exact match: needs
# https:// in production, and no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Optional ──────────────────────────────────────────────────────────────────

# Application Insights connection string. Empty disables telemetry, which is what you want
# locally — no Azure account needed to run the app.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Everything else — model fallback order, per-minute quota, Trivy timeouts, upload limits —
# has a sensible default in app/core/config.py. Set one here only when you need to override it.
