{
  "name": "imageshrink-ai",
  "displayName": "ImageShrink",
  "description": "Lint Dockerfiles as you type. Smaller base images, one-click fixes, CVE scanning and size estimates - entirely offline, no account needed.",
  "version": "1.0.1",
  "publisher": "imageshrink",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "docker",
    "dockerfile",
    "container",
    "security",
    "optimization"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#09090B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Huzaifa4ever/ImageShrink-AI.git"
  },
  "bugs": {
    "url": "https://github.com/Huzaifa4ever/ImageShrink-AI/issues"
  },
  "homepage": "https://github.com/Huzaifa4ever/ImageShrink-AI/tree/main/vscode-extension#readme",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:dockerfile"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Dockerfile linting works everywhere. Security scanning runs the Trivy executable and image size measurement runs Docker, so both are disabled in an untrusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Linting works on virtual files. Security scanning and size measurement need a real file system."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "imageshrink.analyzeDockerfile",
        "title": "Analyze Dockerfile",
        "category": "ImageShrink",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "imageshrink.optimizeDockerfile",
        "title": "Preview Optimized Dockerfile",
        "category": "ImageShrink",
        "icon": "$(diff)"
      },
      {
        "command": "imageshrink.showDiff",
        "title": "Compare With Optimized",
        "category": "ImageShrink",
        "icon": "$(diff)"
      },
      {
        "command": "imageshrink.applyOptimized",
        "title": "Apply Optimized Dockerfile",
        "category": "ImageShrink"
      },
      {
        "command": "imageshrink.createDockerignore",
        "title": "Create .dockerignore",
        "category": "ImageShrink"
      },
      {
        "command": "imageshrink.showReport",
        "title": "Show Report",
        "category": "ImageShrink",
        "icon": "$(graph)"
      },
      {
        "command": "imageshrink.installTrivy",
        "title": "Check Security Scanner",
        "category": "ImageShrink"
      },
      {
        "command": "imageshrink.refresh",
        "title": "Refresh",
        "category": "ImageShrink",
        "icon": "$(refresh)"
      },
      {
        "command": "imageshrink.showOutput",
        "title": "Show Log",
        "category": "ImageShrink"
      },
      {
        "command": "imageshrink.openSettings",
        "title": "Open Settings",
        "category": "ImageShrink",
        "icon": "$(gear)"
      },
      {
        "command": "imageshrink.openFinding",
        "title": "Go to Finding",
        "category": "ImageShrink"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "imageshrink",
          "title": "ImageShrink",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "imageshrink": [
        {
          "id": "imageshrink.overview",
          "name": "Overview",
          "icon": "$(dashboard)"
        },
        {
          "id": "imageshrink.suggestions",
          "name": "Suggestions",
          "icon": "$(lightbulb)"
        },
        {
          "id": "imageshrink.security",
          "name": "Security",
          "icon": "$(shield)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "imageshrink.overview",
        "contents": "Open a Dockerfile to see its optimization, security and performance scores.\n\nSuggestions appear as you type, with no account and no network access.\n\n[Analyze Dockerfile](command:imageshrink.analyzeDockerfile)"
      },
      {
        "view": "imageshrink.security",
        "contents": "Base image vulnerability scanning uses [Trivy](https://trivy.dev), a single binary you install separately.\n\n[Check Security Scanner](command:imageshrink.installTrivy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "imageshrink.refresh",
          "when": "view == imageshrink.overview || view == imageshrink.security",
          "group": "navigation@1"
        },
        {
          "command": "imageshrink.openSettings",
          "when": "view == imageshrink.overview",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "imageshrink.analyzeDockerfile",
          "when": "resourceLangId == dockerfile",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "imageshrink.analyzeDockerfile",
          "when": "resourceLangId == dockerfile",
          "group": "imageshrink@1"
        },
        {
          "command": "imageshrink.showDiff",
          "when": "resourceLangId == dockerfile",
          "group": "imageshrink@2"
        },
        {
          "command": "imageshrink.createDockerignore",
          "when": "resourceLangId == dockerfile",
          "group": "imageshrink@3"
        }
      ],
      "commandPalette": [
        {
          "command": "imageshrink.openFinding",
          "when": "false"
        },
        {
          "command": "imageshrink.refresh",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "ImageShrink",
        "properties": {
          "imageshrink.enableAutoAnalysis": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Analyze Dockerfiles automatically. When off, analysis only runs when you invoke it."
          },
          "imageshrink.analyzeWhileTyping": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Re-check as you type, after a short pause."
          },
          "imageshrink.analyzeOnSave": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Re-check when a Dockerfile is saved."
          },
          "imageshrink.debounceMs": {
            "type": "number",
            "default": 400,
            "minimum": 100,
            "maximum": 5000,
            "order": 4,
            "description": "How long to wait after you stop typing before re-checking, in milliseconds."
          },
          "imageshrink.minimumSeverity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "default": "info",
            "order": 5,
            "description": "Hide findings below this severity."
          },
          "imageshrink.diagnosticsSeverity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "hint"
            ],
            "default": "warning",
            "order": 6,
            "markdownDescription": "How the most severe findings appear in the Problems panel. Less severe findings are reported one step below this."
          }
        }
      },
      {
        "title": "ImageShrink › Security",
        "properties": {
          "imageshrink.security.enabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "Scan base images for known vulnerabilities using [Trivy](https://trivy.dev). Requires Trivy to be installed; everything else works without it."
          },
          "imageshrink.security.trivyPath": {
            "type": "string",
            "default": "trivy",
            "order": 2,
            "description": "Path to the Trivy executable. Leave as 'trivy' if it is on your PATH."
          },
          "imageshrink.security.severities": {
            "type": "string",
            "default": "CRITICAL,HIGH,MEDIUM,LOW",
            "order": 3,
            "description": "Severities to report, comma separated."
          },
          "imageshrink.security.maxImages": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 20,
            "order": 4,
            "description": "Most base images to scan in one analysis."
          },
          "imageshrink.security.maxFindings": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "order": 5,
            "description": "Most vulnerabilities to display, highest severity first."
          },
          "imageshrink.security.timeoutSeconds": {
            "type": "number",
            "default": 120,
            "minimum": 10,
            "maximum": 900,
            "order": 6,
            "description": "How long to allow a single scan before giving up."
          },
          "imageshrink.security.cacheMinutes": {
            "type": "number",
            "default": 60,
            "minimum": 0,
            "maximum": 1440,
            "order": 7,
            "description": "How long to reuse a scan result for the same image. 0 disables caching."
          }
        }
      },
      {
        "title": "ImageShrink › Size",
        "properties": {
          "imageshrink.size.useDocker": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "Ask the local Docker daemon for the real size of base images you have already pulled. Images are never pulled - if one is not present, a published estimate is used instead."
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "imageshrink.analyzeDockerfile",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "resourceLangId == dockerfile"
      }
    ]
  },
  "scripts": {
    "sync-shared": "node scripts/sync-shared.mjs",
    "compile": "npm run sync-shared && node esbuild.mjs",
    "watch": "npm run sync-shared && node esbuild.mjs --watch",
    "package": "npm run sync-shared && node esbuild.mjs --production",
    "typecheck": "npm run sync-shared && tsc --noEmit",
    "test": "npm run typecheck && node scripts/check-parity.mjs && node scripts/check-standalone.mjs",
    "vsix": "vsce package --no-dependencies --out imageshrink-ai.vsix",
    "install-local": "npm run vsix && code --install-extension imageshrink-ai.vsix --force",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
